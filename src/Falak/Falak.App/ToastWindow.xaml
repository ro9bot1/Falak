<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Falak.App.ToastWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="380" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}" xmlns:app="clr-namespace:Falak.App;assembly=Falak">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="Visible" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="Card" Margin="14" CornerRadius="16" Background="{DynamicResource PopupSurface}" BorderBrush="{DynamicResource PopupBorder}" BorderThickness="1" Padding="16,14,16,14">
    <UIElement.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.18" Color="#08140F" />
    </UIElement.Effect>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Name="Tile" Grid.RowSpan="2" Width="42" Height="42" CornerRadius="11" VerticalAlignment="Top" Background="{DynamicResource AccentSoft}">
        <Grid>
          <TextBlock Name="BadgeText" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding Badge}" />
          <TextBlock Name="StateGlyph" Style="{StaticResource Icon}" FontSize="18" Visibility="Collapsed" Foreground="{DynamicResource Accent}" />
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,6,0">
        <TextBlock Name="TitleText" Style="{StaticResource H2}" FontSize="15" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
        <TextBlock Name="MessageText" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,2,0,0" Text="{Binding Message}" />
        <TextBlock Name="LocationLine" Style="{StaticResource Caption}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding LocationText}" />
      </StackPanel>
      <Button Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="0,-4,-6,0" ToolTip="إغلاق" AutomationProperties.Name="إغلاق" Click="Close_Click">
        <TextBlock Style="{StaticResource Icon}" Text="" FontSize="11" />
      </Button>
      <Grid Name="RunningRow" Row="1" Column="1" ColumnSpan="2" Margin="12,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar Name="Bar" Style="{StaticResource SlimProgress}" Minimum="0" Maximum="1" VerticalAlignment="Center" Value="{Binding Progress, Mode=OneWay}" />
        <TextBlock Grid.Column="1" Style="{StaticResource Caption}" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="32" Text="{Binding PercentText}" />
        <Button Grid.Column="2" Content="إلغاء" Style="{StaticResource GhostButton}" Margin="4,0,0,0" Click="Cancel_Click" />
      </Grid>
      <WrapPanel Name="DoneRow" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,12,0,0" Visibility="{Binding HasOutput, Converter={StaticResource Visible}}">
        <Button Content="إظهار في المجلد" Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" Click="Reveal_Click" />
        <Button Name="OpenButton" Content="فتح" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Click="Open_Click" />
        <Button Content="تراجع" Style="{StaticResource GhostButton}" Visibility="{Binding CanUndo, Converter={StaticResource Visible}}" Click="Undo_Click" />
      </WrapPanel>
      <WrapPanel Name="ActionRow" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,12,0,0" Visibility="{Binding HasAction, Converter={StaticResource Visible}}">
        <Button Style="{StaticResource PrimaryButton}" Padding="14,6" Margin="0,0,8,0" Content="{Binding ActionText}" Click="Action_Click" />
        <Button Content="لاحقاً" Style="{StaticResource GhostButton}" Click="Close_Click" />
      </WrapPanel>
    </Grid>
  </Border>
</Window>
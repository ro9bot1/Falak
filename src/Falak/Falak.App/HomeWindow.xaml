<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Falak.App.HomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="فَلَك" Width="940" Height="740" MinWidth="800" MinHeight="600" FlowDirection="RightToLeft" FontFamily="{StaticResource UiFont}" Background="{DynamicResource Bg}" WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/assets/falak.ico" xmlns:app="clr-namespace:Falak.App;assembly=Falak">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="Visible" />
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="{DynamicResource Bg}">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <Grid Name="Root" Background="{DynamicResource Bg}" Margin="0" ClipToBounds="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="32,22,32,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Image Name="Mark" Width="38" Height="38" FlowDirection="LeftToRight" />
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="فَلَك" Style="{StaticResource H2}" FontSize="21" LineHeight="28" />
          <TextBlock Text="Falak · v1.3" Style="{StaticResource Caption}" FontSize="11" LineHeight="16" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,10,0" Background="{DynamicResource SurfaceRaised}">
          <ComboBox Name="LanguageSelector" Width="105" Height="28" FontSize="12" Padding="5,1" Foreground="{DynamicResource Ink}" Background="Transparent" ToolTip="اللغة / Language" SelectionChanged="LanguageSelector_Changed">
            <ComboBoxItem Tag="ar" Content="العربية" />
            <ComboBoxItem Tag="en" Content="English" />
          </ComboBox>
        </Border>
        <Border Name="StatusPill" CornerRadius="999" Padding="12,4" Background="{DynamicResource AccentSoft}" Margin="0,0,16,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Name="StatusText" Text="يعمل في الخلفية" Style="{StaticResource Caption}" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="8,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <CheckBox Name="EnabledSwitch" Style="{StaticResource Switch}" Content="مفعّل" IsChecked="True" AutomationProperties.Name="تفعيل فَلَك" Checked="EnabledSwitch_Changed" Unchecked="EnabledSwitch_Changed" />
        <Button Style="{StaticResource IconButton}" Margin="14,0,0,0" Width="34" Height="34" ToolTip="الإعدادات" AutomationProperties.Name="الإعدادات" Click="Settings_Click">
          <TextBlock Style="{StaticResource Icon}" Text="" FontSize="16" />
        </Button>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="32,18,32,0" Padding="32,22">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" MaxWidth="470" HorizontalAlignment="Left">
          <TextBlock Text="كل ملفاتك. حركة واحدة." Style="{StaticResource Display}" />
          <TextBlock Style="{StaticResource BodyMuted}" Margin="0,8,0,0" Text="اسحب أي ملف في المستكشف، واضغط مفتاحاً أثناء السحب، ثم أفلته على ما تريد. يُحفظ الناتج بجانب الملف الأصلي، ولا يغادر جهازك." />
          <Border Background="{DynamicResource AccentSoft}" CornerRadius="8" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="10,6">
            <TextBlock Text="تحويل محلي  •  خصوصية كاملة  •  دون إنترنت" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
          </Border>
          <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Keycap}" Grid.Row="0" Margin="0,0,0,6" HorizontalAlignment="Left">
              <TextBlock Text="Shift" Style="{StaticResource KeycapText}" />
            </Border>
            <TextBlock Grid.Row="0" Grid.Column="1" Margin="12,0,0,6" Style="{StaticResource Body}" VerticalAlignment="Center">
              <Run x:Name="ShiftTitle" Text="تحويل الصيغة" FontWeight="SemiBold" />
              <Run x:Name="ShiftDetails" Text="  ·  PDF إلى صور، صورة إلى PDF، فيديو إلى MP3" Foreground="{DynamicResource Muted}" />
            </TextBlock>
            <Border Style="{StaticResource Keycap}" Grid.Row="1" Margin="0,0,0,6" HorizontalAlignment="Left">
              <TextBlock Text="Ctrl" Style="{StaticResource KeycapText}" />
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="1" Margin="12,0,0,6" Style="{StaticResource Body}" VerticalAlignment="Center">
              <Run x:Name="CtrlTitle" Text="أدوات" FontWeight="SemiBold" />
              <Run x:Name="CtrlDetails" Text="  ·  ضغط، دمج، فصل الصفحات، إصلاح الترميز" Foreground="{DynamicResource Muted}" />
            </TextBlock>
            <Border Style="{StaticResource Keycap}" Grid.Row="2" HorizontalAlignment="Left">
              <TextBlock Text="Space" Style="{StaticResource KeycapText}" />
            </Border>
            <TextBlock Grid.Row="2" Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource Body}" VerticalAlignment="Center">
              <Run x:Name="SpaceTitle" Text="إجراءات" FontWeight="SemiBold" />
              <Run x:Name="SpaceDetails" Text="  ·  نسخ المسار، نقل، فتح Terminal" Foreground="{DynamicResource Muted}" />
            </TextBlock>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="فتح ملفات فَلَك التجريبية" Style="{StaticResource PrimaryButton}" Click="TrySamples_Click" />
            <Button Content="Code Share" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Click="CodeShare_Click" />
            <Button Name="MacroLibraryButton" Content="التسجيلات" Margin="12,0,0,0" Style="{StaticResource GhostButton}" Click="MacroLibrary_Click" />
          </StackPanel>
        </StackPanel>
        <Image Name="WheelPreview" Grid.Column="1" Width="224" Height="224" Margin="24,-8,0,-8" VerticalAlignment="Center" FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="HighQuality" />
      </Grid>
    </Border>
    <Grid Row="2" Margin="32,22,32,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <TextBlock Text="آخر العمليات" Style="{StaticResource H2}" Margin="0,0,0,10" />
      <Border Name="EmptyState" Grid.Row="1" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Line}" Padding="24,18" VerticalAlignment="Top">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="" FontSize="20" Foreground="{DynamicResource Gold}" VerticalAlignment="Top" Margin="0,4,0,0" />
          <TextBlock Style="{StaticResource BodyMuted}" Margin="14,0,0,0" MaxWidth="560" Text="لم تنفّذ أي عملية بعد. كل ملف تحوّله سيظهر هنا مع مكان حفظه، ويمكنك فتحه أو التراجع عنه بنقرة." />
        </StackPanel>
      </Border>
      <ScrollViewer Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <ItemsControl Name="HistoryList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                    <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight" Text="{Binding Badge}" />
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" LineHeight="24" Text="{Binding Summary}" />
                    <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding Meta}" ToolTip="{Binding Message}" />
                    <ProgressBar Style="{StaticResource SlimProgress}" Height="3" Margin="0,4,0,2" Minimum="0" Maximum="1" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                  </StackPanel>
                  <Border Grid.Column="2" CornerRadius="999" Padding="10,2" VerticalAlignment="Center" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                    <TextBlock Style="{StaticResource Caption}" FontWeight="SemiBold" Text="{Binding StateText}" />
                  </Border>
                  <Button Grid.Column="3" Content="إظهار" Style="{StaticResource GhostButton}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasOutput, Converter={StaticResource Visible}}" Tag="{Binding}" Click="RevealJob_Click" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </Grid>
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Margin="0,16,0,0" Padding="32,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Style="{StaticResource Icon}" Text="" FontSize="13" Foreground="{DynamicResource Gold}" />
          <TextBlock Text="التحويل محلي · المشاركة بإذنك فقط · بلا حساب" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center" />
          <TextBlock Name="ApplicationCredit" FontSize="9" FontWeight="Normal" Foreground="{DynamicResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="VersionText" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" FlowDirection="LeftToRight" />
      </Grid>
    </Border>
  </Grid>
</Window>
